        </mxCell>
        <mxCell id="e1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="Сообщить: нет активной сессии" vertex="1">
          <mxGeometry height="50" width="250" x="760" y="200" as="geometry" />
        </mxCell>
        <mxCell id="elocal" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="Завершить локально: время окончания — сейчас, показания 0" vertex="1">
