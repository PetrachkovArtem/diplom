        <mxCell id="e3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="Сообщить: станция отклонила остановку. Сессия остаётся текущей" vertex="1">
