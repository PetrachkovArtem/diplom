        </mxCell>
        <mxCell id="cur" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="Есть текущая сессия?" vertex="1">
          <mxGeometry height="90" width="240" x="240" y="180" as="geometry" />
        </mxCell>
        <mxCell id="txid" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="У сессии есть transactionId?" vertex="1">
