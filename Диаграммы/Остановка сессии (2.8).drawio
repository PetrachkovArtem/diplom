        </mxCell>
        <mxCell id="wait" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="Сессия остаётся текущей. Ждать TransactionEvent Ended" vertex="1">
          <mxGeometry height="60" width="300" x="210" y="800" as="geometry" />
        </mxCell>
        <mxCell id="rec" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="Записать время окончания, конечное показание и цену из профиля" vertex="1">
          <mxGeometry height="60" width="300" x="210" y="890" as="geometry" />
        </mxCell>
        <mxCell id="hist" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="Сессия завершена и показана в истории" vertex="1">
          <mxGeometry height="50" width="300" x="210" y="980" as="geometry" />
        </mxCell>
        <mxCell id="endok" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="Конец" vertex="1">
