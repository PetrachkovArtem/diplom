        </mxCell>
        <mxCell id="send" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" value="Отправить RequestStopTransaction" vertex="1">
